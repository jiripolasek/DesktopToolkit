<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.InfoLabelExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="using:JPSoftworks.DesktopToolkit.Controls">
    <StackPanel HorizontalAlignment="Left" Spacing="4">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                x:Name="RefreshIntervalLabel"
                VerticalAlignment="Center"
                Text="Refresh interval (seconds)" />
            <info:InfoLabel
                AutomationProperties.AutomationId="RefreshIntervalInfo"
                AutomationProperties.Name="About the refresh interval"
                Description="Shorter intervals use more network data." />
        </StackPanel>
        <NumberBox
            Width="152"
            HorizontalAlignment="Left"
            AutomationProperties.LabeledBy="{x:Bind RefreshIntervalLabel, Mode=OneTime}"
            Minimum="5"
            SpinButtonPlacementMode="Compact"
            Value="30" />
    </StackPanel>
</Page>
