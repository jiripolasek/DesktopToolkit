<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.FormattedInfoLabelExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="using:JPSoftworks.DesktopToolkit.Controls">
    <StackPanel HorizontalAlignment="Left" Spacing="4">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                x:Name="RequestTimeoutLabel"
                VerticalAlignment="Center"
                Text="Request timeout (seconds)" />
            <info:InfoLabel
                AutomationProperties.AutomationId="RequestTimeoutInfo"
                AutomationProperties.Name="About the request timeout"
                Description="{x:Bind RequestTimeoutHelpText.Text, Mode=OneTime}">
                <info:InfoLabel.DescriptionContent>
                    <StackPanel MaxWidth="240" Spacing="4">
                        <TextBlock
                            FontWeight="Bold"
                            Text="When a request times out"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="RequestTimeoutHelpText"
                            Text="The app cancels the request if the server takes longer than this to respond. Increase the timeout on slower connections."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </info:InfoLabel.DescriptionContent>
            </info:InfoLabel>
        </StackPanel>
        <NumberBox
            Width="152"
            HorizontalAlignment="Left"
            AutomationProperties.LabeledBy="{x:Bind RequestTimeoutLabel, Mode=OneTime}"
            Minimum="1"
            SpinButtonPlacementMode="Compact"
            Value="10" />
    </StackPanel>
</Page>
