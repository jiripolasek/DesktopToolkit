<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.ShortcutEditorExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keys="using:JPSoftworks.DesktopToolkit.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.KeyVisual/Themes/KeyVisualStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel x:Name="SampleLayout" Spacing="12">
        <toolkit:SettingsCard Header="Open launcher">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE756;" />
            </toolkit:SettingsCard.HeaderIcon>
            <keys:ShortcutEditor x:Name="LauncherEditor" AllowClear="{x:Bind ClearSwitch.IsOn, Mode=OneWay}" />
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Open search">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE721;" />
            </toolkit:SettingsCard.HeaderIcon>
            <keys:ShortcutEditor
                x:Name="SearchEditor"
                AllowClear="{x:Bind ClearSwitch.IsOn, Mode=OneWay}"
                PreviewKeycapStyle="{StaticResource DefaultKeyVisualStyle}" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="SampleOptions">
            <ToggleSwitch
                x:Name="ClearSwitch"
                Header="Allow clearing"
                IsOn="True" />
        </StackPanel>
    </StackPanel>
</Page>
