<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.ShortcutCommandListExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keys="using:JPSoftworks.DesktopToolkit.Controls">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.KeyVisual/Themes/KeyVisualStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="CommandKeyStyle"
                BasedOn="{StaticResource SmallKeyVisualStyle}"
                TargetType="keys:KeyVisual">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ListView
        MaxWidth="520"
        HorizontalAlignment="Stretch"
        AutomationProperties.Name="Commands and shortcuts"
        SelectionMode="None">
        <ListViewItem HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="New document"
                    TextWrapping="Wrap" />
                <keys:ShortcutPresenter
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    KeycapStyle="{StaticResource CommandKeyStyle}"
                    Shortcut="{x:Bind NewDocumentShortcut}" />
            </Grid>
        </ListViewItem>
        <ListViewItem HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE8E5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="Open project"
                    TextWrapping="Wrap" />
                <keys:ShortcutPresenter
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    KeycapStyle="{StaticResource CommandKeyStyle}"
                    Shortcut="{x:Bind OpenProjectShortcut}" />
            </Grid>
        </ListViewItem>
        <ListViewItem HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE721;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="Find in files"
                    TextWrapping="Wrap" />
                <keys:ShortcutPresenter
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    KeycapStyle="{StaticResource CommandKeyStyle}"
                    Shortcut="{x:Bind FindInFilesShortcut}" />
            </Grid>
        </ListViewItem>
    </ListView>
</Page>
