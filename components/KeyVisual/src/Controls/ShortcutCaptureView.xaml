<UserControl
    x:Class="JPSoftworks.DesktopToolkit.Controls.ShortcutCaptureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.DesktopToolkit.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.KeyVisual/Themes/KeyVisualStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="CaptureKeycapStyle"
                BasedOn="{StaticResource LargeKeyVisualStyle}"
                TargetType="local:KeyVisual">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="16">
        <TextBlock x:Name="CaptureInstructions" TextWrapping="Wrap" />
        <local:ShortcutCaptureSurface
            x:Name="CaptureSurface"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Shortcut input"
            IsTabStop="True"
            KeyDown="OnCaptureKeyDown"
            KeyUp="OnCaptureKeyUp"
            LostFocus="OnCaptureLostFocus"
            Tapped="OnCaptureTapped"
            UseSystemFocusVisuals="True">
            <Border
                MinHeight="84"
                Padding="12,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid>
                    <local:ShortcutPresenter
                        x:Name="CapturePreview"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock
                        x:Name="EmptyLabel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No shortcut assigned" />
                </Grid>
            </Border>
        </local:ShortcutCaptureSurface>
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="ResetButton"
                Click="OnResetClick"
                Content="Use default"
                Style="{StaticResource SubtleButtonStyle}" />
            <Button
                x:Name="ClearButton"
                Click="OnClearClick"
                Content="None"
                Style="{StaticResource SubtleButtonStyle}" />
        </StackPanel>
        <TextBlock
            x:Name="ValidationMessage"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
