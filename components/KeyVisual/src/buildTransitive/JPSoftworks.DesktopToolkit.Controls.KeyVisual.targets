<Project>
  <ItemGroup>
    <!-- The library PRI already indexes these resources. -->
    <None Include="$(MSBuildThisFileDirectory)**\*.xbf">
      <Link>JPSoftworks.DesktopToolkit.Controls.KeyVisual\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>JPSoftworks.DesktopToolkit.Controls.KeyVisual\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
