<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/WinUI.props" />
  <PropertyGroup>
    <RootNamespace>JPSoftworks.DesktopToolkit.Controls.KeyVisualControlTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041;net11.0-windows10.0.19041</TargetFrameworks>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'ARM64')">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="../src/JPSoftworks.DesktopToolkit.Controls.KeyVisual.csproj" />
  </ItemGroup>
</Project>
