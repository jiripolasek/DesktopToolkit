<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.DateRangePickerExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dates="using:JPSoftworks.DesktopToolkit.Controls">
    <StackPanel Spacing="12">
        <dates:DateRangePicker
            MinWidth="220"
            HorizontalAlignment="Left"
            Header="Reporting dates"
            IsComparisonEnabled="True"
            Presets="{x:Bind Presets}"
            Selection="{x:Bind Selection, Mode=TwoWay}"
            SelectionChanged="OnSelectionChanged" />
        <TextBlock
            x:Name="Status"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
