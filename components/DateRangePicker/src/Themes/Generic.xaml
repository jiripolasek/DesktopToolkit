<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JPSoftworks.DesktopToolkit.Controls">
    <Style TargetType="controls:DateRangePicker">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="RangeHighlightBrush">
            <Setter.Value>
                <SolidColorBrush Opacity="0.22" Color="{ThemeResource SystemAccentColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="RangeEndpointBrush">
            <Setter.Value>
                <SolidColorBrush Opacity="0.48" Color="{ThemeResource SystemAccentColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DateRangePicker">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="PART_Header"
                            LineHeight="20"
                            Text="{TemplateBinding Header}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <DropDownButton
                            x:Name="PART_Button"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            HorizontalContentAlignment="Left">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="MaxWidth" Value="660" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="12">
                                        <ComboBox
                                            x:Name="PART_Presets"
                                            HorizontalAlignment="Stretch"
                                            Header="Preset"
                                            PlaceholderText="Choose a preset" />
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <Grid ColumnDefinitions="300,300" ColumnSpacing="12">
                                                <Grid.Resources>
                                                    <Thickness x:Key="CalendarViewWeekDayPadding">0,4,0,4</Thickness>
                                                </Grid.Resources>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Start date" />
                                                    <CalendarView
                                                        x:Name="PART_StartCalendar"
                                                        Height="344"
                                                        MinWidth="0"
                                                        AutomationProperties.Name="Start date calendar"
                                                        CalendarItemCornerRadius="4"
                                                        SelectionMode="Single" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="End date" />
                                                    <CalendarView
                                                        x:Name="PART_EndCalendar"
                                                        Height="344"
                                                        MinWidth="0"
                                                        AutomationProperties.Name="End date calendar"
                                                        CalendarItemCornerRadius="4"
                                                        SelectionMode="Single" />
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                x:Name="PART_RangeSummary"
                                                AutomationProperties.LiveSetting="Polite"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                            <CheckBox x:Name="PART_Comparison" Content="Compare previous period" />
                                            <TextBlock
                                                x:Name="PART_ComparisonSummary"
                                                AutomationProperties.LiveSetting="Polite"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="PART_Error"
                                            AutomationProperties.LiveSetting="Assertive"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                x:Name="PART_Apply"
                                                Content="Apply"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="PART_Cancel" Content="Cancel" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
