<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.DesktopToolkit.Styles">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PillSearchBoxBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PillSearchBoxBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="PillSearchBoxBorderBrush" ResourceKey="TextControlBorderBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style
        x:Key="PillSearchBoxStyle"
        BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}"
        TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{ThemeResource PillSearchBoxBorderBrush}" />
        <Setter Property="local:SearchBoxLayout.UseLeadingQueryIcon" Value="True" />
    </Style>
</ResourceDictionary>
