<Page
    x:Class="JPSoftworks.DesktopToolkit.Styles.Samples.SettingsSearchBoxStylePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:JPSoftworks.DesktopToolkit.Gallery.UI">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled">
        <StackPanel
            Width="{x:Bind PageScroll.ViewportWidth, Mode=OneWay}"
            Padding="0,0,0,40"
            Spacing="24">
            <ui:GalleryPageHeader
                x:Name="PageHeader"
                Title="Search box"
                ApiNamespace="Microsoft.UI.Xaml.Controls"
                ApiNotes="Merge the SettingsSearchBoxStyle.xaml dictionary from JPSoftworks.DesktopToolkit.Styles. Apply SettingsSearchBoxStyle to an AutoSuggestBox and set QueryIcon to Find."
                Description="A pill-shaped AutoSuggestBox with a leading magnifier, inspired by Command Palette Settings."
                Glyph="&#xE721;" />
            <ui:ExampleCard
                x:Name="SearchBoxExample"
                Description="Type to preview the field and its clear button."
                Header="Settings search">
                <Border
                    Padding="16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="6">
                    <AutoSuggestBox
                        MaxWidth="480"
                        AutomationProperties.Name="Search settings"
                        Header="Search settings"
                        PlaceholderText="Find a setting"
                        QueryIcon="Find"
                        Style="{StaticResource SettingsSearchBoxStyle}" />
                </Border>
            </ui:ExampleCard>
        </StackPanel>
    </ScrollViewer>
</Page>
