<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.DevApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JPSoftworks.DesktopToolkit.Controls">
    <ScrollViewer AutomationProperties.AutomationId="DemoScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="720"
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Filterable menus and dropdowns" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Native commands and virtualized choices with search that stays beside its anchor."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleSwitch
                    x:Name="LargeMenuToggle"
                    AutomationProperties.AutomationId="LargeMenuToggle"
                    Header="Large menu"
                    IsOn="True"
                    OffContent="8 commands"
                    OnContent="10,008 commands"
                    Toggled="OnLargeMenuToggled" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Theme" />
                    <controls:SearchableDropDown
                        x:Name="ThemePicker"
                        Width="160"
                        AutomationProperties.AutomationId="ThemePicker"
                        AutomationProperties.Name="Theme"
                        SelectionChanged="OnThemeChanged" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    AutomationProperties.AutomationId="MenuDirectionToggle"
                    Header="Menu direction"
                    OffContent="Left to right"
                    OnContent="Right to left"
                    Toggled="OnMenuDirectionToggled" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OpenMenuButton"
                    AutomationProperties.AutomationId="OpenMenuButton"
                    Content="Virtualized menu">
                    <Button.Flyout>
                        <controls:SearchableItemsFlyout
                            x:Name="ButtonMenu"
                            FilterChanged="OnMenuFilterChanged"
                            ItemInvoked="OnItemInvoked"
                            Opened="OnMenuOpened" />
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.AutomationId="NativeMenuButton" Content="Built-in menu">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="OnNativeItemClick"
                                KeyboardAcceleratorTextOverride="Ctrl+N"
                                Text="New file">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Click="OnNativeItemClick"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Text="Save">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem Click="OnNativeItemClick" Text="Pin to favorites">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem IsEnabled="False" Text="Export selection" />
                            <MenuFlyoutSubItem Text="Export as">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Click="OnNativeItemClick" Text="PDF document" />
                                <MenuFlyoutItem Click="OnNativeItemClick" Text="PNG image" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.AutomationId="NativeOverflowButton" Content="Built-in overflow">
                    <Button.Flyout>
                        <MenuFlyout x:Name="NativeOverflowMenu" Opened="OnNativeOverflowOpened">
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter">
                                    <Setter Property="AutomationProperties.AutomationId" Value="NativeOverflowItems" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.AutomationId="SearchableNativeMenuButton" Content="Searchable native">
                    <Button.Flyout>
                        <controls:SearchableMenuFlyout
                            x:Name="NativeSearchMenu"
                            FilterChanged="OnNativeSearchFilterChanged"
                            MaxListHeight="240">
                            <MenuFlyoutItem
                                controls:SearchableMenuFlyout.Keywords="create document"
                                Click="OnSearchableNativeItemClick"
                                Text="New file">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                controls:SearchableMenuFlyout.Keywords="write document"
                                Click="OnSearchableNativeItemClick"
                                Text="Save">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator
                                        Key="S"
                                        Invoked="OnNativeSearchAcceleratorInvoked"
                                        Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem
                                controls:SearchableMenuFlyout.Keywords="bookmark star"
                                Click="OnSearchableNativeItemClick"
                                Text="Pin to favorites">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <SplitMenuFlyoutItem Command="{x:Bind NativeSearchCommand}" Text="Open recent">
                                <MenuFlyoutItem Click="OnSearchableNativeItemClick" Text="Project one" />
                                <MenuFlyoutItem Click="OnSearchableNativeItemClick" Text="Project two" />
                            </SplitMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem IsEnabled="False" Text="Export selection" />
                            <MenuFlyoutSubItem controls:SearchableMenuFlyout.Keywords="format output pdf png svg" Text="Export as">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem
                                    controls:SearchableMenuFlyout.Keywords="print portable"
                                    Click="OnSearchableNativeItemClick"
                                    Text="PDF document" />
                                <MenuFlyoutItem
                                    controls:SearchableMenuFlyout.Keywords="picture bitmap"
                                    Click="OnSearchableNativeItemClick"
                                    Text="PNG image" />
                                <MenuFlyoutItem
                                    controls:SearchableMenuFlyout.Keywords="scalable graphic"
                                    Click="OnSearchableNativeItemClick"
                                    Text="SVG vector" />
                                <MenuFlyoutSubItem Text="More formats">
                                    <MenuFlyoutItem Click="OnSearchableNativeItemClick" Text="JPEG image" />
                                    <MenuFlyoutItem Click="OnSearchableNativeItemClick" Text="WebP image" />
                                </MenuFlyoutSubItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Sort by">
                                <RadioMenuFlyoutItem
                                    Click="OnSearchableNativeItemClick"
                                    GroupName="NativeSearchSort"
                                    IsChecked="True"
                                    Text="By name" />
                                <RadioMenuFlyoutItem
                                    Click="OnSearchableNativeItemClick"
                                    GroupName="NativeSearchSort"
                                    Text="By date" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind NativeAdvancedCommands, Mode=TwoWay}" Text="Show advanced commands" />
                            <MenuFlyoutItem
                                Click="OnSearchableNativeItemClick"
                                Text="Advanced action"
                                Visibility="{x:Bind NativeAdvancedCommands, Mode=OneWay}" />
                        </controls:SearchableMenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Border
                x:Name="ContextTarget"
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Border.ContextFlyout>
                    <controls:SearchableItemsFlyout
                        x:Name="ContextMenu"
                        FilterChanged="OnMenuFilterChanged"
                        ItemInvoked="OnItemInvoked"
                        Opened="OnMenuOpened" />
                </Border.ContextFlyout>
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Right-click here" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The filter follows the opening edge and stays put as results change."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="ShowAtButton"
                            Click="OnShowAtClick"
                            Content="Show at this target" />
                        <Button
                            x:Name="AboveAnchorButton"
                            AutomationProperties.AutomationId="AboveAnchorButton"
                            Content="Open above anchor">
                            <Button.Flyout>
                                <controls:SearchableItemsFlyout
                                    x:Name="AboveMenu"
                                    FilterChanged="OnMenuFilterChanged"
                                    ItemInvoked="OnItemInvoked"
                                    Opened="OnMenuOpened"
                                    Placement="TopEdgeAlignedLeft" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Sensitivity (filtered)" />
                    <controls:SearchableDropDown
                        x:Name="SensitivityPicker"
                        Width="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="SensitivityPicker"
                        AutomationProperties.Name="Sensitivity"
                        SelectedIndex="1"
                        SelectionChanged="OnSensitivityChanged">
                        <controls:SearchableDropDown.Items>
                            <x:String>Low</x:String>
                            <x:String>Medium</x:String>
                            <x:String>High</x:String>
                        </controls:SearchableDropDown.Items>
                    </controls:SearchableDropDown>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Sensitivity (built-in)" />
                    <ComboBox
                        x:Name="NativeSensitivityPicker"
                        Width="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="NativeSensitivityPicker"
                        AutomationProperties.Name="Built-in sensitivity"
                        SelectedIndex="1"
                        SelectionChanged="OnNativeSensitivityChanged">
                        <x:String>Low</x:String>
                        <x:String>Medium</x:String>
                        <x:String>High</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Spacing="4">
                    <TextBlock Text="Workspace" />
                    <controls:SearchableDropDown
                        x:Name="WorkspacePicker"
                        Width="240"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="WorkspacePicker"
                        AutomationProperties.Name="Workspace"
                        FilterPlaceholderText="Search 10,000 workspaces..."
                        SelectionChanged="OnWorkspaceChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Library (icons)" />
                    <controls:SearchableDropDown
                        x:Name="LibraryPicker"
                        Width="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="LibraryPicker"
                        AutomationProperties.Name="Library"
                        FilterPlaceholderText="Search libraries..."
                        SelectedIndex="0"
                        SelectionChanged="OnLibraryChanged">
                        <controls:SearchableDropDown.Items>
                            <controls:SearchableFlyoutItem
                                Glyph="&#xE8A5;"
                                Keywords="text files"
                                Text="Documents" />
                            <controls:SearchableFlyoutItem
                                Glyph="&#xEB9F;"
                                Keywords="photos images"
                                Text="Pictures" />
                            <controls:SearchableFlyoutItem
                                Glyph="&#xE8D6;"
                                Keywords="audio songs"
                                Text="Music" />
                            <controls:SearchableFlyoutItem Keywords="movies clips" Text="Videos">
                                <controls:SearchableFlyoutItem.IconSource>
                                    <SymbolIconSource Symbol="Video" />
                                </controls:SearchableFlyoutItem.IconSource>
                            </controls:SearchableFlyoutItem>
                        </controls:SearchableDropDown.Items>
                    </controls:SearchableDropDown>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last action" />
                <TextBlock
                    x:Name="LastActionText"
                    AutomationProperties.AutomationId="LastActionText"
                    AutomationProperties.LiveSetting="Polite"
                    Text="No command selected yet."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SelectionStatusText"
                    AutomationProperties.AutomationId="SelectionStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DiagnosticsText"
                    AutomationProperties.AutomationId="DiagnosticsText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Open a menu to inspect virtualization."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Expander
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="AccessibilitySamples"
                Header="Accessibility and live updates">
                <StackPanel Spacing="12">
                    <TextBlock Text="These samples use custom automation labels and result messages." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="AccessibleMenuButton" Content="Accessible commands">
                            <Button.Flyout>
                                <controls:SearchableItemsFlyout
                                    FilterBoxAutomationName="Find an operation"
                                    NoResultsText="No operations found"
                                    Strings="{x:Bind AccessibilityStrings, Mode=OneTime}">
                                    <controls:SearchableFlyoutItem
                                        AutomationHelpText="Shows details for the selected destination."
                                        AutomationId="InspectDestination"
                                        AutomationName="Inspect selected destination"
                                        Text="Inspect" />
                                    <controls:SearchableFlyoutItem IsSeparator="True" />
                                    <controls:SearchableFlyoutItem
                                        AutomationId="FavoriteDestination"
                                        IsCheckable="True"
                                        Text="Favorite" />
                                    <controls:SearchableFlyoutItem AutomationId="MoreDestination" Text="More">
                                        <controls:SearchableFlyoutItem Text="Copy address" />
                                    </controls:SearchableFlyoutItem>
                                </controls:SearchableItemsFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button AutomationProperties.AutomationId="AccessibleNativeButton" Content="Accessible native">
                            <Button.Flyout>
                                <controls:SearchableMenuFlyout
                                    FilterBoxAutomationName="Find a native operation"
                                    NoResultsText="No operations found"
                                    Strings="{x:Bind AccessibilityStrings, Mode=OneTime}">
                                    <MenuFlyoutItem
                                        AutomationProperties.HelpText="Shows details for the selected destination."
                                        AutomationProperties.Name="Inspect selected destination"
                                        Text="Inspect" />
                                    <ToggleMenuFlyoutItem Text="Favorite" />
                                </controls:SearchableMenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DestinationLabel" Text="Destination" />
                    <controls:SearchableDropDown
                        x:Name="LiveChoicesPicker"
                        Width="240"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="LiveChoicesPicker"
                        AutomationProperties.LabeledBy="{x:Bind DestinationLabel, Mode=OneTime}"
                        FilterBoxAutomationName="Find a destination"
                        FilterPlaceholderText="Search destinations..."
                        NoResultsText="No matching destinations"
                        SelectedIndex="0">
                        <controls:SearchableDropDown.ItemTemplate>
                            <DataTemplate x:DataType="controls:SearchableFlyoutItem">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind AutomationHelpText, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:SearchableDropDown.ItemTemplate>
                        <controls:SearchableFlyoutItem
                            x:Name="LiveChoiceData"
                            AutomationHelpText="Receives new windows."
                            AutomationId="PrimaryDisplayChoice"
                            AutomationName="Primary display destination"
                            Text="Primary display" />
                        <controls:SearchableFlyoutItem AutomationHelpText="Extends the desktop." Text="Secondary display" />
                    </controls:SearchableDropDown>
                    <Button
                        AutomationProperties.AutomationId="RenameDestinationButton"
                        Click="OnRenameDestination"
                        Content="Rename selected destination" />
                </StackPanel>
            </Expander>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Type to filter. Up/Down navigates, Enter chooses, and Esc cancels. Export as opens a submenu. Try 'recent 042' in the command menu."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
