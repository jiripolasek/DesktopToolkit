<Application
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.ControlTests.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ChoiceDetail">
                <TextBlock MinHeight="64" Text="{Binding Description}" />
            </DataTemplate>
            <DataTemplate x:Key="ChoiceLabel">
                <TextBlock Text="{Binding Label}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
