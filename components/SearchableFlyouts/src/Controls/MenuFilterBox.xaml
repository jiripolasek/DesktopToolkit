<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <StaticResource x:Key="TextControlBackground" ResourceKey="ControlAltFillColorSecondaryBrush" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#10000000" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlAltFillColorSecondaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style
        x:Key="MenuFilterBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6,12,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
</ResourceDictionary>
