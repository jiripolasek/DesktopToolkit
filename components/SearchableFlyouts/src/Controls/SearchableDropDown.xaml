<?xml version="1.0" encoding="utf-8" ?>
<DropDownButton
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableDropDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="160"
    MinHeight="32"
    HorizontalContentAlignment="Stretch"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    Unloaded="OnUnloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            x:Name="SelectedGlyphIcon"
            Width="16"
            Margin="0,0,8,0"
            AutomationProperties.AccessibilityView="Raw"
            FontFamily="{ThemeResource SymbolThemeFontFamily}"
            FontSize="14"
            Visibility="Collapsed" />
        <Viewbox
            x:Name="SelectedSourceIconHost"
            Width="16"
            Height="16"
            Margin="0,0,8,0"
            Stretch="Uniform"
            Visibility="Collapsed">
            <IconSourceElement x:Name="SelectedSourceIcon" AutomationProperties.AccessibilityView="Raw" />
        </Viewbox>
        <Grid Grid.Column="1">
            <TextBlock x:Name="SelectedTextBlock" TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="PlaceholderTextBlock"
                Foreground="{ThemeResource ComboBoxPlaceHolderForeground}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</DropDownButton>
