<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.SearchableMenuFlyoutExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="using:JPSoftworks.DesktopToolkit.Controls">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <DropDownButton Content="Document actions">
            <DropDownButton.Flyout>
                <menus:SearchableMenuFlyout FilterBoxAutomationName="Find a document action">
                    <MenuFlyoutItem
                        menus:SearchableMenuFlyout.Keywords="create file"
                        Click="OnAction"
                        Text="New document">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        menus:SearchableMenuFlyout.Keywords="duplicate"
                        Click="OnAction"
                        Text="Save a copy">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Save" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnAction" Text="Print">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Print" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem
                        menus:SearchableMenuFlyout.Keywords="bookmark star"
                        Click="OnPinChanged"
                        Text="Pin to favorites" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem IsEnabled="False" Text="Export selection" />
                    <MenuFlyoutSubItem menus:SearchableMenuFlyout.Keywords="format output" Text="Export as">
                        <MenuFlyoutSubItem.Icon>
                            <SymbolIcon Symbol="Share" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem
                            menus:SearchableMenuFlyout.Keywords="portable print"
                            Click="OnAction"
                            Text="PDF document" />
                        <MenuFlyoutItem Click="OnAction" Text="PNG image" />
                        <MenuFlyoutSubItem Text="More formats">
                            <MenuFlyoutItem Click="OnAction" Text="JPEG image" />
                            <MenuFlyoutItem Click="OnAction" Text="SVG vector" />
                        </MenuFlyoutSubItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Sort by">
                        <RadioMenuFlyoutItem
                            Click="OnAction"
                            GroupName="DocumentSort"
                            IsChecked="True"
                            Text="Name" />
                        <RadioMenuFlyoutItem
                            Click="OnAction"
                            GroupName="DocumentSort"
                            Text="Date modified" />
                    </MenuFlyoutSubItem>
                </menus:SearchableMenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock
            x:Name="ActionResult"
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
    </Grid>
</Page>
