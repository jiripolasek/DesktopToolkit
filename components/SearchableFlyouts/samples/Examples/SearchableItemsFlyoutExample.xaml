<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.SearchableItemsFlyoutExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="using:JPSoftworks.DesktopToolkit.Controls">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <DropDownButton Content="Virtualized menu">
            <DropDownButton.Flyout>
                <menus:SearchableItemsFlyout
                    x:Name="CommandMenu"
                    FilterBoxAutomationName="Find a command or recent document"
                    FilterPlaceholderText="Search commands and recent documents..."
                    IsResultCountVisible="True"
                    ItemInvoked="OnItemInvoked"
                    Strings="{x:Bind MenuStrings}" />
            </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock
            x:Name="CommandResult"
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
    </Grid>
</Page>
