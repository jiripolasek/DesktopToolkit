<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.SearchableDropDownIconsExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="using:JPSoftworks.DesktopToolkit.Controls">
    <menus:SearchableDropDown
        Width="216"
        HorizontalAlignment="Left"
        AutomationProperties.Name="Save location"
        FilterBoxAutomationName="Find a save location"
        FilterPlaceholderText="Search save locations..."
        PlaceholderText="Select a save location"
        SelectedIndex="0">
        <menus:SearchableFlyoutItem Glyph="&#xE7F4;" Text="Desktop" />
        <menus:SearchableFlyoutItem Glyph="&#xE8A5;" Text="Documents" />
        <menus:SearchableFlyoutItem Glyph="&#xE896;" Text="Downloads" />
        <menus:SearchableFlyoutItem Glyph="&#xE8B9;" Text="Pictures" />
    </menus:SearchableDropDown>
</Page>
