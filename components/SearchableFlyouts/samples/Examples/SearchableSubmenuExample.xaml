<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.SearchableSubmenuExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="using:JPSoftworks.DesktopToolkit.Controls">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <DropDownButton Content="Export document">
            <DropDownButton.Flyout>
                <menus:SearchableMenuFlyout
                    FilterBoxAutomationName="Find an export option"
                    FilterPlaceholderText="Search export options..."
                    Strings="{x:Bind MenuStrings}">
                    <MenuFlyoutSubItem Text="Document formats">
                        <MenuFlyoutItem
                            menus:SearchableMenuFlyout.Keywords="portable print"
                            Click="OnFormatSelected"
                            Text="PDF document" />
                        <MenuFlyoutItem Click="OnFormatSelected" Text="Word document" />
                        <MenuFlyoutItem Click="OnFormatSelected" Text="Plain text" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Image formats">
                        <MenuFlyoutItem Click="OnFormatSelected" Text="PNG image" />
                        <MenuFlyoutItem Click="OnFormatSelected" Text="JPEG image" />
                        <MenuFlyoutItem Click="OnFormatSelected" Text="SVG vector" />
                    </MenuFlyoutSubItem>
                </menus:SearchableMenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock
            x:Name="ExportResult"
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
    </Grid>
</Page>
