<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.SearchableDropDownExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="using:JPSoftworks.DesktopToolkit.Controls">
    <menus:SearchableDropDown
        Width="216"
        HorizontalAlignment="Left"
        AutomationProperties.Name="Destination"
        FilterBoxAutomationName="Find a destination"
        FilterPlaceholderText="Search destinations..."
        PlaceholderText="Select a destination">
        <x:String>Desktop</x:String>
        <x:String>Documents</x:String>
        <x:String>Downloads</x:String>
        <x:String>Pictures</x:String>
    </menus:SearchableDropDown>
</Page>
