<UserControl
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.Controls.SamplePageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:JPSoftworks.DesktopToolkit.Gallery.UI">
    <ui:GalleryPageHeader
        x:Name="PageHeader"
        Title="{x:Bind Title, Mode=OneWay}"
        ApiNamespace="JPSoftworks.DesktopToolkit.Charts"
        ApiNotes="{x:Bind ApiNotes, Mode=OneWay}"
        Description="{x:Bind Description, Mode=OneWay}"
        Glyph="&#xE9D9;" />
</UserControl>
