<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.Pages.FunnelChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:JPSoftworks.DesktopToolkit.Charts"
    xmlns:demo="using:JPSoftworks.DesktopToolkit.Controls.Demo.Controls"
    xmlns:sample="using:JPSoftworks.DesktopToolkit.Gallery.UI">
    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Left"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            Padding="0,0,0,40"
            HorizontalAlignment="Left"
            Spacing="24">
            <demo:SamplePageHeader
                Title="Funnel chart"
                ApiNotes="Use StageAlignment to align stage bands. Use FunnelChartData.FromSeries and Presentation=Flow to display cohort ribbons. The inspector shows counts and conversion from the first and previous stages."
                Description="Compare stage totals or follow the groups that make up each stage."
                StylingControl="FunnelChart"
                StylingExample="FlowExample" />
            <sample:ExampleCard
                x:Name="FlowExample"
                Header="Trial to paid subscription"
                PreviewVerticalAlignment="Top">
                <charts:FunnelChart
                    x:Name="Diagram"
                    Height="318"
                    AutomationProperties.Name="Trial to paid subscription conversion stages"
                    Data="{x:Bind Conversion}"
                    IsTapered="{x:Bind TaperSwitch.IsOn, Mode=OneWay}"
                    ShowLabels="{x:Bind LabelsSwitch.IsOn, Mode=OneWay}"
                    StageAlignment="{x:Bind GetStageAlignment(AlignmentBox.SelectedIndex), Mode=OneWay}"
                    StageCornerRadius="{x:Bind RadiusSlider.Value, Mode=OneWay}"
                    StageSpacing="{x:Bind SpacingSlider.Value, Mode=OneWay}"
                    ValueFormat="N0" />
                <sample:ExampleCard.SampleControls>
                    <StackPanel Spacing="12">
                        <ComboBox
                            x:Name="AlignmentBox"
                            HorizontalAlignment="Stretch"
                            Header="Stage alignment"
                            SelectedIndex="0">
                            <x:String>Left</x:String>
                            <x:String>Center</x:String>
                            <x:String>Right</x:String>
                        </ComboBox>
                        <ToggleSwitch
                            x:Name="TaperSwitch"
                            Header="Tapered stages"
                            IsOn="True" />
                        <Slider
                            x:Name="SpacingSlider"
                            Header="Stage spacing"
                            Maximum="20"
                            Value="6" />
                        <Slider
                            x:Name="RadiusSlider"
                            Header="Stage corner radius"
                            Maximum="20"
                            Value="6" />
                        <ToggleSwitch
                            x:Name="LabelsSwitch"
                            Header="Stage labels"
                            IsOn="True" />
                    </StackPanel>
                </sample:ExampleCard.SampleControls>
                <sample:ExampleCard.Options>
                    <demo:ChartSampleOptions Target="{x:Bind Diagram}" />
                </sample:ExampleCard.Options>
            </sample:ExampleCard>
            <sample:ExampleCard
                x:Name="CohortExample"
                Description="See how many requests from each channel remain at every support stage."
                Header="Support requests by channel">
                <charts:FunnelChart
                    x:Name="CohortFlow"
                    Height="290"
                    charts:ChartLegend.HighlightOnHover="True"
                    AutomationProperties.Name="Support requests by channel and stage"
                    Data="{x:Bind SupportRequests}"
                    Presentation="Flow"
                    ValueFormat="N0" />
                <sample:ExampleCard.Options>
                    <demo:ChartSampleOptions Target="{x:Bind CohortFlow}" />
                </sample:ExampleCard.Options>
            </sample:ExampleCard>
        </StackPanel>
    </ScrollViewer>
</Page>
