<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.Pages.ScatterChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:JPSoftworks.DesktopToolkit.Charts"
    xmlns:demo="using:JPSoftworks.DesktopToolkit.Controls.Demo.Controls"
    xmlns:sample="using:JPSoftworks.DesktopToolkit.Gallery.UI">
    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Left"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            Padding="0,0,0,40"
            HorizontalAlignment="Left"
            Spacing="24">
            <demo:SamplePageHeader
                Title="Scatter chart"
                ApiNotes="Bind a ScatterChartData snapshot. Points accept finite numeric X and Y values in any order. Hover over a point or use the arrow keys on the focused chart to inspect it."
                Description="Compare paired measurements to see how request size relates to latency."
                StylingControl="ScatterChart"
                StylingExample="SubtleExample" />
            <sample:ExampleCard
                x:Name="RequestExample"
                Header="Request size versus latency"
                PreviewVerticalAlignment="Top">
                <charts:ScatterChart
                    x:Name="Requests"
                    Height="280"
                    AutomationProperties.Name="Request size in kilobytes versus latency in milliseconds"
                    Data="{x:Bind RequestData}"
                    MarkerSize="{x:Bind MarkerSizeSlider.Value, Mode=OneWay}"
                    Milestones="{x:Bind RequestMilestones}"
                    XAxis="{x:Bind SizeAxis}"
                    XValueFormat="0' KB'"
                    YAxis="{x:Bind LatencyAxis}"
                    YValueFormat="0' ms'" />
                <sample:ExampleCard.SampleControls>
                    <StackPanel Spacing="12">
                        <Slider
                            x:Name="MarkerSizeSlider"
                            Header="Marker size"
                            Maximum="18"
                            Minimum="3"
                            Value="8" />
                    </StackPanel>
                </sample:ExampleCard.SampleControls>
                <sample:ExampleCard.Options>
                    <demo:ChartSampleOptions Target="{x:Bind Requests}" />
                </sample:ExampleCard.Options>
            </sample:ExampleCard>
            <sample:ExampleCard
                x:Name="SubtleExample"
                Description="A compact view with softer axis labels, smaller markers, and no gridlines."
                Header="Scatter with subtle axes">
                <charts:ScatterChart
                    x:Name="SubtleRequests"
                    Height="176"
                    charts:ChartAxisAppearance.Presentation="Subtle"
                    AutomationProperties.Name="Compact scatter plot of request size versus latency"
                    Data="{x:Bind RequestData}"
                    MarkerSize="6"
                    ShowGrid="False"
                    XAxis="{x:Bind SubtleAxis}"
                    XValueFormat="0' KB'"
                    YAxis="{x:Bind SubtleAxis}"
                    YValueFormat="0' ms'" />
                <sample:ExampleCard.Options>
                    <demo:ChartSampleOptions Target="{x:Bind SubtleRequests}" />
                </sample:ExampleCard.Options>
            </sample:ExampleCard>
        </StackPanel>
    </ScrollViewer>
</Page>
