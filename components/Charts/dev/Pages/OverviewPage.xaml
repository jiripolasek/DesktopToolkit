<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:JPSoftworks.DesktopToolkit.Charts"
    xmlns:controls="using:JPSoftworks.DesktopToolkit.Controls.Demo.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Styles/GalleryColorIcons.xaml" />
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Styles/GalleryColorIcons.xaml" />
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.Charts.Samples/Styles/GalleryMonochromeIcons.xaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Left"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MaxWidth="1100"
            HorizontalAlignment="Left"
            Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Fluent charts for WinUI apps"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource ChartsDescriptionStyle}" Text="Explore time series, category comparisons, resource meters, and proportional charts. Try the controls, adjust their options, and copy a sample into your app." />
            </StackPanel>
            <charts:LiveAreaGraph
                x:Name="PreviewGraph"
                Height="230"
                AutomationProperties.Name="Example CPU and memory history"
                IsTooltipEnabled="False" />
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Explore the controls" />
            <StackPanel Spacing="4">
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource LiveAreaGraphIcon}"
                    Click="OnLiveClick"
                    Description="Scrolling history, multiple series, and pointer or keyboard inspection."
                    Header="Live area graph"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource LineChartIcon}"
                    Click="OnLineChartClick"
                    Description="Plot supplied measurements on a numeric or time axis."
                    Header="Line chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource ScatterChartIcon}"
                    Click="OnScatterChartClick"
                    Description="Compare paired measurements across one or more series."
                    Header="Scatter chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SpiderChartIcon}"
                    Click="OnSpiderClick"
                    Description="Compare profiles across several numeric dimensions."
                    Header="Spider chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource HeatmapChartIcon}"
                    Click="OnHeatmapClick"
                    Description="Color a matrix of measurements or a calendar of daily activity."
                    Header="Heatmap"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SankeyChartIcon}"
                    Click="OnSankeyClick"
                    Description="Follow weighted flows between sources and destinations."
                    Header="Sankey chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource FunnelChartIcon}"
                    Click="OnFunnelClick"
                    Description="Compare counts and conversion through ordered stages."
                    Header="Funnel chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource TreemapIcon}"
                    Click="OnTreemapClick"
                    Description="Compare sizes within a hierarchy."
                    Header="Treemap"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource IcicleIcon}"
                    Click="OnIcicleClick"
                    Description="Follow weighted branches across hierarchy levels."
                    Header="Icicle"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SunburstIcon}"
                    Click="OnSunburstClick"
                    Description="Explore a weighted hierarchy in concentric rings."
                    Header="Sunburst"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource BarChartIcon}"
                    Click="OnBarChartClick"
                    Description="Compare categories with grouped bars, stacked totals, or percentage shares."
                    Header="Bar chart"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource UsageBarIcon}"
                    Click="OnBarClick"
                    Description="Vertical or horizontal resource levels with optional stacked contributions."
                    Header="Usage bar"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource RadialGaugeIcon}"
                    Click="OnGaugeClick"
                    Description="Show a current value on a semicircle with optional threshold bands."
                    Header="Radial gauge"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource DoughnutIcon}"
                    Click="OnDoughnutClick"
                    Description="Compare proportional slices with an optional responsive legend."
                    Header="Doughnut and pie"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    Click="OnLegendsClick"
                    Description="Move a chart legend or place it in a separate panel."
                    Header="Chart legends"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SystemMonitorIcon}"
                    Click="OnDashboardWidgetsClick"
                    Description="Show memory composition and service latency in compact chart tiles."
                    Header="Dashboard widgets"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SystemMonitorIcon}"
                    Click="OnMonitorClick"
                    Description="See live CPU, memory, and on-demand network readings."
                    Header="System monitor"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource MemoryAnalysisIcon}"
                    Click="OnMemoryAnalysisClick"
                    Description="Compare heap snapshots and explore retained buffers from a managed workload."
                    Header="Memory analysis"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource SalesPerformanceIcon}"
                    Click="OnSalesPerformanceClick"
                    Description="Investigate planned versus actual revenue and returns by channel."
                    Header="Sales performance"
                    IsClickEnabled="True" />
                <toolkit:SettingsCard
                    controls:GalleryIcon.Template="{ThemeResource LineChartIcon}"
                    Click="OnWebAnalyticsClick"
                    Description="Compare traffic channels and find where shoppers drop out of checkout."
                    Header="Web analytics"
                    IsClickEnabled="True" />
            </StackPanel>
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Get started">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource ChartsDescriptionStyle}" Text="Add the Charts package to a WinUI 3 application and keep its standard XamlControlsResources." />
                    <TextBlock Style="{StaticResource ChartsCodeStyle}" Text="&lt;PackageReference Include=&quot;JPSoftworks.DesktopToolkit.Controls.Charts&quot; Version=&quot;0.1.0-preview.1&quot; /&gt;&#xA;&#xA;xmlns:charts=&quot;using:JPSoftworks.DesktopToolkit.Charts&quot;" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
