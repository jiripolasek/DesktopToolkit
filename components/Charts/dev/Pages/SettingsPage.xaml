<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Left"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MaxWidth="1064"
            HorizontalAlignment="Left"
            Spacing="24">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />
                <toolkit:SettingsCard Description="Choose the appearance of the gallery and its controls." Header="Application theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeBox"
                        MinWidth="200"
                        AutomationProperties.Name="Application theme"
                        SelectedIndex="0"
                        SelectionChanged="OnThemeChanged">
                        <x:String>Use system setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="About" />
                <toolkit:SettingsExpander
                    x:Name="AboutExpander"
                    Description="Interactive examples for the JPSoftworks chart controls."
                    Header="JPSoftworks Desktop Toolkit Gallery">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="JPSoftworks.DesktopToolkit.Controls.Charts" Header="Library" />
                        <toolkit:SettingsCard Description="Apache License 2.0" Header="License">
                            <HyperlinkButton Content="Read the license" NavigateUri="https://www.apache.org/licenses/LICENSE-2.0" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="WinUI Gallery and Windows Community Toolkit are used under the MIT license." Header="Acknowledgments" />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
