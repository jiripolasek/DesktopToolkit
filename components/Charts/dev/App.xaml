<Application
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Styles/GalleryColorIcons.xaml" />
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Styles/GalleryColorIcons.xaml" />
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.Charts.Samples/Styles/GalleryMonochromeIcons.xaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.Charts.Samples/Styles/ChartSampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
