<Window
    x:Class="JPSoftworks.DesktopToolkit.Controls.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JPSoftworks.DesktopToolkit.Controls.Demo.Controls"
    Title="JPSoftworks Desktop Toolkit Gallery">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  TitleBar composition adapted from WinUI Gallery (MIT).  -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="JPSoftworks Controls Gallery"
            BackRequested="OnTitleBarBackRequested"
            IconSource="{ThemeResource GalleryIcon}"
            IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MaxWidth="580"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search controls and samples"
                    PlaceholderText="Search controls and samples..."
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Invoked="OnSearchAccelerator"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            ItemInvoked="OnItemInvoked"
            OpenPaneLength="300"
            PaneDisplayMode="Auto"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary Source="ms-appx:///JPSoftworks.DesktopToolkit.Controls.Charts.Samples/Styles/GalleryMonochromeIcons.xaml" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Overview"
                    Icon="Home"
                    Tag="overview" />
                <NavigationViewItemHeader Content="Charts" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource LiveAreaGraphIcon}"
                    Content="Live area graph"
                    Tag="live" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource LineChartIcon}"
                    Content="Line chart"
                    Tag="line-chart" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource ScatterChartIcon}"
                    Content="Scatter chart"
                    Tag="scatter-chart" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource SpiderChartIcon}"
                    Content="Spider chart"
                    Tag="spider-chart" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource HeatmapChartIcon}"
                    Content="Heatmap"
                    Tag="heatmap" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource SankeyChartIcon}"
                    Content="Sankey chart"
                    Tag="sankey" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource FunnelChartIcon}"
                    Content="Funnel chart"
                    Tag="funnel" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource TreemapIcon}"
                    Content="Treemap"
                    Tag="treemap" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource IcicleIcon}"
                    Content="Icicle"
                    Tag="icicle" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource SunburstIcon}"
                    Content="Sunburst"
                    Tag="sunburst" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource BarChartIcon}"
                    Content="Bar chart"
                    Tag="bar-chart" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource UsageBarIcon}"
                    Content="Usage bar"
                    Tag="bar" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource RadialGaugeIcon}"
                    Content="Radial gauge"
                    Tag="gauge" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource DoughnutIcon}"
                    Content="Doughnut and pie"
                    Tag="doughnut" />
                <NavigationViewItem Content="Chart legends" Tag="legends">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Scenarios" />
                <NavigationViewItem
                    Content="Dashboard widgets"
                    Icon="ViewAll"
                    Tag="dashboard-widgets" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource SystemMonitorIcon}"
                    Content="System monitor"
                    Tag="monitor" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource MemoryAnalysisIcon}"
                    Content="Memory analysis"
                    Tag="memory-analysis" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource SalesPerformanceIcon}"
                    Content="Sales performance"
                    Tag="sales-performance" />
                <NavigationViewItem
                    controls:GalleryIcon.Template="{StaticResource LineChartIcon}"
                    Content="Web analytics"
                    Tag="web-analytics" />
            </NavigationView.MenuItems>
            <Frame
                x:Name="ContentFrame"
                Margin="36,32,36,0"
                Navigated="OnNavigated"
                SizeChanged="OnContentSizeChanged" />
        </NavigationView>
    </Grid>
</Window>
