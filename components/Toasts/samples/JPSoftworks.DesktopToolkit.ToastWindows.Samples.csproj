<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/WinUI.props" />
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/JPSoftworks.DesktopToolkit.ToastWindows.csproj" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <EmbeddedResource Include="Examples/*.xaml;Examples/*.xaml.cs"
                      LogicalName="ExampleSource.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
