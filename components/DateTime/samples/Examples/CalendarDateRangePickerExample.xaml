<Page
    x:Class="JPSoftworks.DesktopToolkit.Controls.Samples.CalendarDateRangePickerExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dates="using:JPSoftworks.DesktopToolkit.Controls">
    <StackPanel Spacing="12">
        <dates:CalendarDateRangePicker
            MinWidth="220"
            HorizontalAlignment="Left"
            DraftReset="OnDraftReset"
            Header="Reporting dates"
            Presets="{x:Bind Presets}"
            Selection="{x:Bind Selection, Mode=TwoWay}"
            SelectionApplying="OnSelectionApplying"
            SelectionChanged="OnSelectionChanged">
            <dates:CalendarDateRangePicker.FlyoutHeader>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Website traffic report" />
            </dates:CalendarDateRangePicker.FlyoutHeader>
            <dates:CalendarDateRangePicker.FlyoutFooter>
                <ToggleSwitch x:Name="ComparePreviousPeriod" Header="Compare with previous period" />
            </dates:CalendarDateRangePicker.FlyoutFooter>
        </dates:CalendarDateRangePicker>
        <TextBlock
            x:Name="Status"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
