<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/WinUI.ControlTests.props" />

  <PropertyGroup>
    <RootNamespace>JPSoftworks.DesktopToolkit.Controls.DateTimeControlTests</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="../src/JPSoftworks.DesktopToolkit.Controls.DateTime.csproj" />
  </ItemGroup>

  <Target Name="PublishTestAppResources" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="$(GenerateProjectPriFile)">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" RelativePath="App.xbf" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
