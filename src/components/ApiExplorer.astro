---
import packages from '../../.api-reference/explorer.json';

const types = packages.flatMap(({ slug, title, packageId, types }) =>
  types.map((type) => ({ ...type, packageSlug: slug, packageTitle: title, packageId })),
).sort((left, right) => left.title.localeCompare(right.title));

const typesByNamespace = new Map<string, typeof types>();
for (const type of types) {
  const namespace = type.namespace || 'Global namespace';
  const group = typesByNamespace.get(namespace) ?? [];
  group.push(type);
  typesByNamespace.set(namespace, group);
}
const namespaces = [...typesByNamespace].sort(([left], [right]) => left.localeCompare(right));
---

<div class="api-explorer not-content" data-api-explorer>
  <div class="filters" role="search" aria-label="API explorer" hidden>
    <label for="api-query" class="query">
      Search types and members
      <input id="api-query" type="search" placeholder="Try CalendarDateRangePicker or Selection" autocomplete="off" spellcheck="false" />
    </label>
    <label for="api-namespace">
      Namespace
      <select id="api-namespace">
        <option value="">All namespaces</option>
        {namespaces.map(([namespace]) => <option value={namespace}>{namespace}</option>)}
      </select>
    </label>
    <label for="api-package">
      Package
      <select id="api-package">
        <option value="">All packages</option>
        {packages.map(({ slug, title }) => <option value={slug}>{title}</option>)}
      </select>
    </label>
  </div>

  <p class="result-count" role="status">{types.length} types</p>
  {namespaces.map(([namespace, group]) => (
    <section class="namespace" data-api-namespace={namespace}>
      <h2 class="namespace-title">{namespace}</h2>
      <ul class="types" aria-label={'Types in ' + namespace}>
        {group.map((type) => (
          <li
            data-api-type={type.fullName}
            data-package={type.packageSlug}
            data-search={[type.fullName, type.title, type.packageTitle, type.packageId].join(' ')}
            data-members={JSON.stringify(type.members)}
          >
            <div class="type">
              <a href={type.url} title={type.fullName}>{type.title}</a>
              <span>{type.packageTitle}</span>
            </div>
            <ul class="members" hidden></ul>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  type Member = { anchor: string; label: string };

  const explorer = document.querySelector<HTMLElement>('[data-api-explorer]');
  if (explorer) {
    const filters = explorer.querySelector<HTMLElement>('.filters')!;
    const query = explorer.querySelector<HTMLInputElement>('#api-query')!;
    const namespaceFilter = explorer.querySelector<HTMLSelectElement>('#api-namespace')!;
    const packageFilter = explorer.querySelector<HTMLSelectElement>('#api-package')!;
    const status = explorer.querySelector<HTMLElement>('[role="status"]')!;
    const groups = explorer.querySelectorAll<HTMLElement>('[data-api-namespace]');
    const types = [...explorer.querySelectorAll<HTMLElement>('[data-api-type]')].map((row) => {
      const searchText = row.dataset.search!.toLowerCase();
      const members = (JSON.parse(row.dataset.members!) as Member[]).map((member) => ({
        ...member,
        searchText: (row.dataset.apiType + '.' + member.label).toLowerCase() + ' ' + searchText,
      }));
      return {
        row,
        group: row.closest<HTMLElement>('[data-api-namespace]')!,
        searchText,
        members,
        packageSlug: row.dataset.package,
        url: row.querySelector<HTMLAnchorElement>('a')!.href,
        results: row.querySelector<HTMLUListElement>('.members')!,
      };
    });

    function filter() {
      const terms = query.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      const matches = (text: string) => terms.every((term) => text.includes(term));
      const namespace = namespaceFilter.value;
      const packageSlug = packageFilter.value;
      const visibleGroups = new Set<HTMLElement>();
      let typeCount = 0;
      let memberCount = 0;

      for (const type of types) {
        if ((namespace && type.group.dataset.apiNamespace !== namespace) || (packageSlug && type.packageSlug !== packageSlug)) {
          type.row.hidden = true;
          continue;
        }

        const typeMatches = matches(type.searchText);
        const members = typeMatches ? [] : type.members.filter((member) => matches(member.searchText));
        type.row.hidden = !typeMatches && !members.length;
        if (type.row.hidden) continue;
        visibleGroups.add(type.group);
        typeCount++;
        memberCount += members.length;
        type.results.replaceChildren(...members.map(({ anchor, label }) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = type.url + '#' + encodeURIComponent(anchor);
          link.textContent = label;
          item.append(link);
          return item;
        }));
        type.results.hidden = !members.length;
      }

      for (const group of groups) group.hidden = !visibleGroups.has(group);
      if (!typeCount) {
        status.textContent = 'No matches. Try a different search or filter.';
        return;
      }

      status.textContent = typeCount + (typeCount === 1 ? ' type' : ' types');
      if (memberCount) status.textContent += ', ' + memberCount + (memberCount === 1 ? ' matching member' : ' matching members');
    }

    query.addEventListener('input', filter);
    namespaceFilter.addEventListener('change', filter);
    packageFilter.addEventListener('change', filter);
    filters.hidden = false;
    filter();
  }
</script>

<style>
  .filters:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 13rem);
    gap: 1rem;
  }

  .query {
    grid-column: 1 / -1;
  }

  label {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    font-weight: 600;
  }

  input,
  select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--toolkit-control-fill);
    color: var(--sl-color-white);
    font: inherit;
    font-weight: 400;
  }

  .result-count {
    margin-block: 1.25rem 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .namespace {
    margin-block-start: 1.25rem;
  }

  .namespace-title {
    margin-block: 0 0.375rem;
    font-family: var(--sl-font-system-mono);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }

  .types,
  .members {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .types > li {
    padding-block: 0.625rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
  }

  .type {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .type span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .type a,
  .members :global(a) {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-system-mono);
    overflow-wrap: anywhere;
  }

  .type a {
    font-weight: 600;
  }

  .members {
    margin-block-start: 0.375rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }

  .members :global(a) {
    display: block;
    padding-block: 0.25rem;
  }

  @media (max-width: 42rem) {
    .filters:not([hidden]) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
