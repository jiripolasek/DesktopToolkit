<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NuGet prunes transitive SDK metapackage versions up to this value, inclusive. -->
    <DesktopToolkitWindowsAppSDKVersion>2.6.5</DesktopToolkitWindowsAppSDKVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0" />
    <!-- Standalone package consumer checks use the full SDK to verify compatibility. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="$(DesktopToolkitWindowsAppSDKVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="$(DesktopToolkitWindowsAppSDKVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260224000" />
    <PackageVersion Update="Microsoft.WindowsAppSDK.WinUI" Version="$(DesktopToolkitWindowsAppSDKVersion)"
                    Condition="'$(MSBuildProjectName)' == 'JPSoftworks.DesktopToolkit.ToastWindows' or
                               '$(MSBuildProjectName)' == 'JPSoftworks.DesktopToolkit.Controls.KeyVisual.DevApp' or
                               '$(MSBuildProjectName)' == 'JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.DevApp' or
                               '$(MSBuildProjectName)' == 'JPSoftworks.DesktopToolkit.Gallery'" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="WinUIEdit" Version="0.0.5-prerelease" />
  </ItemGroup>
</Project>
