<Window
    x:Class="JPSoftworks.DesktopToolkit.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JPSoftworks Desktop Toolkit Gallery">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootLayout"
        KeyboardAcceleratorPlacementMode="Hidden"
        RowDefinitions="Auto,Auto,*"
        SizeChanged="OnShellSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="K"
                Invoked="OnSearchShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="OnBackShortcut"
                Modifiers="Menu" />
        </Grid.KeyboardAccelerators>
        <Grid
            x:Name="GalleryTitleBar"
            Height="48"
            Background="Transparent"
            Loaded="OnTitleBarLoaded">
            <Grid.Resources>
                <Style
                    x:Key="TitleBarButtonStyle"
                    BasedOn="{StaticResource SubtleButtonStyle}"
                    TargetType="Button">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TitleBarBackButton"
                Grid.Column="1"
                AutomationProperties.Name="Back"
                Click="OnBackRequested"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="16"
                    Glyph="&#xE72B;"
                    MirroredWhenRightToLeft="True" />
            </Button>
            <Button
                x:Name="TitleBarPaneToggleButton"
                Grid.Column="2"
                AutomationProperties.Name="Toggle navigation"
                Click="OnPaneToggleRequested"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="Toggle navigation">
                <FontIcon FontSize="16" Glyph="&#xE700;" />
            </Button>
            <Grid
                x:Name="TitleBarContentGrid"
                Grid.Column="3"
                Margin="8,0"
                SizeChanged="OnTitleBarContentSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBarBrandColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="TitleBarIdentity"
                    Margin="0,0,8,0"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">
                    <Image
                        x:Name="ControlsSuiteLogo"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/Square44x44Logo.png" />
                    <TextBlock
                        x:Name="TitleBarBrand"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
                <AutoSuggestBox
                    x:Name="GallerySearch"
                    Grid.Column="1"
                    MinWidth="144"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    AutomationProperties.AcceleratorKey="Ctrl+K"
                    AutomationProperties.Name="Search controls and samples"
                    PlaceholderText="Search controls and samples"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted"
                    Style="{StaticResource SettingsSearchBoxStyle}"
                    TextChanged="OnSearchTextChanged"
                    ToolTipService.ToolTip="Search controls and samples (Ctrl+K)"
                    UpdateTextOnSelect="False" />
            </Grid>
        </Grid>
        <Grid
            x:Name="CompactSearchHost"
            Grid.Row="1"
            Margin="16,0,16,8"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <AutoSuggestBox
                x:Name="CompactGallerySearch"
                AutomationProperties.AcceleratorKey="Ctrl+K"
                AutomationProperties.Name="Search controls and samples"
                PlaceholderText="Search controls and samples"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                Style="{StaticResource SettingsSearchBoxStyle}"
                TextChanged="OnSearchTextChanged"
                ToolTipService.ToolTip="Search controls and samples (Ctrl+K)"
                UpdateTextOnSelect="False" />
        </Grid>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1008"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnNavigationItemInvoked"
            OpenPaneLength="224">
            <NavigationView.Resources>
                <Style TargetType="NavigationViewItemHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItemHeader">
                                <Grid x:Name="NavigationViewItemHeaderRootGrid">
                                    <TextBlock
                                        x:Name="HeaderText"
                                        Margin="16,12,16,2"
                                        CharacterSpacing="80"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{TemplateBinding Content}" />
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="PaneStates">
                                            <VisualState x:Name="HeaderTextVisible" />
                                            <VisualState x:Name="HeaderTextCollapsed">
                                                <VisualState.Setters>
                                                    <Setter Target="HeaderText.Visibility" Value="Collapsed" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeItem"
                    Content="Home"
                    Icon="Home" />
            </NavigationView.MenuItems>
            <Frame x:Name="PageFrame" Navigated="OnPageNavigated" />
        </NavigationView>
    </Grid>
</Window>
