<Page
    x:Class="JPSoftworks.DesktopToolkit.Gallery.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:JPSoftworks.DesktopToolkit.Gallery.UI">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled">
        <StackPanel
            Width="{x:Bind PageScroll.ViewportWidth, Mode=OneWay}"
            Padding="32,20,32,40"
            Spacing="24">
            <ui:GalleryPageHeader x:Name="PageHeader" />
            <StackPanel x:Name="ExampleList" Spacing="24" />
        </StackPanel>
    </ScrollViewer>
</Page>
