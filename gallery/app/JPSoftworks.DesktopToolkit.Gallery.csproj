<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/WinUI.PackagedApp.props" />

  <PropertyGroup>
    <Version>0.1.0-preview.2</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishPortableGallery)' != 'true' and '$(PublishAot)' == 'true'">
    <!-- Use the Native AOT symbols from the publish output. -->
    <IncludeDebugSymbolsProjectOutputGroup>false</IncludeDebugSymbolsProjectOutputGroup>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishPortableGallery)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishPortableGallery)' == 'true' and '$(PublishSingleFileGallery)' == 'true'">
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- WinUI requires full extraction for native DLL redirection. -->
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishPortableGallery)' == 'true'">
    <Content Update="Assets\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../components/Charts/dev/ThirdParty/*.txt" Link="ThirdParty/Charts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Condition="'$(PublishPortableGallery)' != 'true'" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <!-- SettingsControls brings in the SDK metapackage. The Gallery prunes it in both publish modes. -->
    <!-- WinUI supplies the UI assets. Runtime adds the Windows App Runtime dependency for MSIX. -->
    <PrunePackageReference Include="Microsoft.WindowsAppSDK" Version="$(DesktopToolkitWindowsAppSDKVersion)" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WinUIEdit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ui/JPSoftworks.DesktopToolkit.Gallery.UI.csproj" />
    <ProjectReference Include="../../components/Charts/samples/JPSoftworks.DesktopToolkit.Controls.Charts.Samples.csproj" />
    <ProjectReference Include="../../components/DateTime/samples/JPSoftworks.DesktopToolkit.Controls.DateTime.Samples.csproj" />
    <ProjectReference Include="../../components/InfoLabel/samples/JPSoftworks.DesktopToolkit.Controls.InfoLabel.Samples.csproj" />
    <ProjectReference Include="../../components/KeyVisual/samples/JPSoftworks.DesktopToolkit.Controls.KeyVisual.Samples.csproj" />
    <ProjectReference Include="../../components/SearchableFlyouts/samples/JPSoftworks.DesktopToolkit.Controls.SearchableFlyouts.Samples.csproj" />
    <ProjectReference Include="../../components/Styles/samples/JPSoftworks.DesktopToolkit.Styles.Samples.csproj" />
    <ProjectReference Include="../../components/Styles/src/JPSoftworks.DesktopToolkit.Styles.csproj" />
    <ProjectReference Include="../../components/Toasts/samples/JPSoftworks.DesktopToolkit.ToastWindows.Samples.csproj" />
  </ItemGroup>
</Project>
