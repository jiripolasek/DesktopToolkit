<UserControl
    x:Class="JPSoftworks.DesktopToolkit.Gallery.UI.GalleryPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.DesktopToolkit.Gallery.UI"
    IsTabStop="False">
    <UserControl.Resources>
        <Style
            x:Key="NuGetFlyoutPresenterStyle"
            BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
            TargetType="FlyoutPresenter">
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="20"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="{x:Bind Glyph, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ToggleButton
                x:Name="PreviewThemeToggle"
                Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Alternate sample theme"
                Checked="OnPreviewThemeToggled"
                ToolTipService.ToolTip="Preview samples in the opposite theme"
                Unchecked="OnPreviewThemeToggled"
                Visibility="{x:Bind PreviewThemeToggleVisibility, Mode=OneWay}">
                <FontIcon FontSize="16" Glyph="&#xE706;" />
            </ToggleButton>
        </Grid>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Description, Mode=OneWay}"
            TextWrapping="Wrap" />
        <local:ResourceButtonPanel x:Name="ResourceLinks">
            <Button
                x:Name="ApiInformationButton"
                AutomationProperties.Name="API information"
                ToolTipService.ToolTip="API information">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        Glyph="&#xE946;" />
                    <TextBlock Text="API" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel MaxWidth="420" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Namespace" />
                            <TextBlock
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ApiNamespace, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ApiNotes, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </local:ResourceButtonPanel>
    </StackPanel>
</UserControl>
