<Page
    x:Class="JPSoftworks.DesktopToolkit.Gallery.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.DesktopToolkit.Gallery">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <ImageBrush
                        x:Key="HomeHeroBackgroundBrush"
                        AlignmentX="Left"
                        ImageSource="ms-appx:///Assets/HomeHero.jpg"
                        Stretch="UniformToFill" />
                    <LinearGradientBrush x:Key="HomeHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#B3000616" />
                        <GradientStop Offset="0.46" Color="#66000616" />
                        <GradientStop Offset="0.75" Color="#00000616" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ImageBrush
                        x:Key="HomeHeroBackgroundBrush"
                        AlignmentX="Left"
                        ImageSource="ms-appx:///Assets/HomeHero.jpg"
                        Stretch="UniformToFill" />
                    <LinearGradientBrush x:Key="HomeHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#B3000616" />
                        <GradientStop Offset="0.46" Color="#66000616" />
                        <GradientStop Offset="0.75" Color="#00000616" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HomeHeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HomeHeroScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="HomeCardTemplate" x:DataType="local:GalleryDestination">
                <Button
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    AutomationProperties.HelpText="{x:Bind Description, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Click="OnCardClicked"
                    CornerRadius="8"
                    Tag="{x:Bind Mode=OneTime}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Content="{x:Bind CreateIcon(), Mode=OneTime}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneTime}"
                                TextWrapping="Wrap" />
                            <FontIcon
                                Grid.Column="2"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;"
                                MirroredWhenRightToLeft="True" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Center"
        HorizontalScrollMode="Disabled">
        <StackPanel
            Width="{x:Bind PageScroll.ViewportWidth, Mode=OneWay}"
            MaxWidth="1200"
            Padding="32,28,32,40"
            Spacing="28">
            <Border
                x:Name="HeroBanner"
                MinHeight="256"
                Background="{ThemeResource HomeHeroBackgroundBrush}"
                CornerRadius="12"
                RequestedTheme="Dark">
                <Grid
                    Padding="32"
                    Background="{ThemeResource HomeHeroScrimBrush}"
                    CornerRadius="12">
                    <StackPanel
                        x:Name="HeroCopy"
                        MaxWidth="240"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Image
                            x:Name="PublisherLogo"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Left"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/PublisherLogo.png"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="HeroTitle"
                            AutomationProperties.HeadingLevel="Level1"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Desktop Toolkit"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="Explore reusable WinUI components through interactive examples."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind local:GalleryCatalog.Sections, Mode=OneTime}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="28" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:GallerySection">
                        <StackPanel Spacing="12">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneTime}" />
                            <ItemsRepeater ItemTemplate="{StaticResource HomeCardTemplate}" ItemsSource="{x:Bind Destinations, Mode=OneTime}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="4"
                                        MinColumnSpacing="12"
                                        MinItemHeight="128"
                                        MinItemWidth="232"
                                        MinRowSpacing="12"
                                        Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeroWidthStates">
                <VisualState x:Name="CompactHero">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideHero">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroCopy.MaxWidth" Value="360" />
                        <Setter Target="HeroTitle.Style" Value="{ThemeResource TitleLargeTextBlockStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
