<Project>
  <!-- Sets default frameworks, platforms, and SDK references for WinUI sample libraries. -->
  <Import Project="$(MSBuildThisFileDirectory)WinUI.props" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">$(DesktopToolkitAppTargetFramework)</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.WindowsAppSDK.WinUI" Version="$(DesktopToolkitWindowsAppSDKVersion)"
                    Condition="'$(MSBuildProjectName)' != 'JPSoftworks.DesktopToolkit.Controls.Charts.Samples'" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <!-- SettingsControls can bring in the SDK metapackage. WinUI supplies the required SDK assets. -->
    <!-- Pruning applies per project. Consuming apps need their own rule. -->
    <PrunePackageReference Include="Microsoft.WindowsAppSDK" Version="$(DesktopToolkitWindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>
</Project>
